# Laravel specific
# Ignore the CONTENTS but keep the directory: git doesn't track empty dirs, so
# ignoring the folder outright meant a fresh clone had no bootstrap/cache and
# Laravel refused to boot ("must be present and writable"). CI papers over it
# with mkdir -p; local setups just broke.
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/storage/*.key
/backend/storage/app/public/
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/public/hot
/backend/public/storage
/backend/public/mix-manifest.json
/backend/.phpunit.result.cache
/backend/Homestead.json
/backend/Homestead.yaml
/backend/auth.json

# Nuxt specific
/frontend/.nuxt/
/frontend/.output/
/frontend/dist/
/admin/.nuxt/
/admin/.output/
/admin/dist/

# Vercel build output (NITRO_PRESET=vercel writes here on a local build)
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/
*.lcov
.phpunit.result.cache

# Docker
docker/mysql/data/
docker/redis/data/

